// The English site (verbumdomini.ca) as a Cloudflare Worker that serves static files.
// Deployed by .github/workflows/deploy-english.yml after verbumdomini/tools/build.ps1 -EnglishSite writes verbumdomini/_site_en/.
// Address: https://verbumdomini.ca (no workers.dev address: it would serve the site outside the zone's rules)
{
  "name": "verbumdomini",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare creates the DNS record and the certificate for a custom domain by itself
  "routes": [{ "pattern": "verbumdomini.ca", "custom_domain": true }],
  "assets": {
    "directory": "../_site_en",
    "binding": "ASSETS",
    // The pages link to /mass.html etc., so serve the files under their own names, no rewriting.
    // Requests that match no file go to worker.js ("/", addresses without ".html", and 404s).
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Contact form (contact.js): sends mail through Cloudflare Email Routing. Email Routing must be on
  // for verbumdomini.ca. The receiving address and the Turnstile secret key are secrets set in the
  // Cloudflare dashboard (TO_ADDRESS, TURNSTILE_SECRET), never here; deploys keep them.
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  // contact.js allows 3 posts a minute from one address
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": { "FROM_ADDRESS": "form@verbumdomini.ca" }
}
